# ===================== App-Icons =====================

def get_app_icon(app_name, app_path):
    display = Gdk.Display.get_default()
    if display is None:
        return None
    theme = Gtk.IconTheme.get_for_display(display)

    icon_map = {"gimp": "gimp", "krita": "krita", "pinta": "pinta",
                "inkscape": "inkscape", "eog": "eog", "shotwell": "shotwell",
                "libreoffice": "libreoffice-draw",
                "kolourpaint": "kolourpaint", "mypaint": "mypaint",
                "firefox": "firefox", "google-chrome": "google-chrome",
                "chromium": "chromium-browser", "display": "imagemagick"}

    names = [app_name.lower(),
             app_path.split("/")[-1].lower(),
             app_name.lower().replace(" ", ""),
             app_name.lower().replace(" ", "-")]
    candidates = []
    for n in names:
        if n in icon_map:
            candidates.append(icon_map[n])
        candidates.append(n)
    candidates.extend(["applications-graphics", "image-x-generic", "image-viewer"])

    for ic in candidates:
        try:
            if theme.has_icon(ic):
                return theme.load_icon(ic, 32, 0)
        except Exception:
            pass

    for p in (f"/usr/share/applications/{app_name.lower()}.desktop",
              f"/usr/share/applications/{app_path.split('/')[-1]}.desktop"):
        if os.path.exists(p):
            try:
                with open(p, "r", errors="ignore") as f:
                    for line in f:
                        if line.startswith("Icon="):
                            ic = line.split("=", 1)[1].strip()
                            try:
                                if theme.has_icon(ic):
                                    return theme.load_icon(ic, 32, 0)
                            except Exception:
                                pass
            except Exception:
                pass
    return None


def find_installed_image_apps():
    known = [("GIMP", "gimp"), ("Krita", "krita"), ("Pinta", "pinta"),
             ("Inkscape", "inkscape"), ("Shotwell", "shotwell"),
             ("GNOME Bildbetrachter", "eog"),
             ("LibreOffice Draw", "libreoffice"),
             ("KolourPaint", "kolourpaint"), ("MyPaint", "mypaint"),
             ("Firefox", "firefox"), ("Chrome", "google-chrome"),
             ("Chromium", "chromium"), ("ImageMagick", "display")]
    found = []
    paths = os.environ.get("PATH", "").split(":")
    for name, binary in known:
        for p in paths:
            full = os.path.join(p, binary)
            if os.path.exists(full) and os.access(full, os.X_OK):
                try:
                    icon = get_app_icon(name, full)
                except Exception:
                    icon = None
                found.append((name, full, icon))
                break
    return found


