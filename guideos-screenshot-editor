    def on_timer_changed(self, dropdown, _pspec):
        idx = dropdown.get_selected()
        delay = [0, 3, 5, 10][idx] if 0 <= idx < 4 else 0
        self.timer_delay = delay
        save_timer_setting(delay)

    def _reset_timer(self):
        self.timer_delay = 0
        if self.timer_combo.get_selected() != 0:
            self.timer_combo.set_selected(0)
        save_timer_setting(0)

    def _start_countdown(self, callback):
        if self.timer_delay <= 0:
            GLib.idle_add(callback)
            return
        self._countdown_overlay = CountdownOverlay(self.timer_delay,
                                                   parent=self)
        self._countdown_overlay.present()

        remaining = self.timer_delay

        def _tick():
            nonlocal remaining
            remaining -= 1
            if remaining > 0:
                if self._countdown_overlay:
                    self._countdown_overlay.set_remaining(remaining)
                return True
            else:
                if self._countdown_overlay:
                    self._countdown_overlay.close()
                    self._countdown_overlay = None
                GLib.timeout_add(150, lambda: (callback(), False)[1])
                return False

        self._countdown_source_id = GLib.timeout_add(1000, _tick)

    # =====================================================================
    #  Aufnahme-Wege
    # =====================================================================

    def _open_editor(self, pixbuf):
        if pixbuf is None:
            print("✘ Aufnahme fehlgeschlagen")
            self.set_visible(True)
            return
        self._reset_timer()
        self.set_visible(False)
        editor = EditorWindow(image_pixbuf=pixbuf,
                              application=self.get_application())
        editor.connect("close-request",
                       lambda w: (self.set_visible(True), False)[1])
        editor.present()

    def on_area_clicked(self, btn):
        self.set_visible(False)

        def _run_selector():
            selector = AreaSelectorWindow(parent=self)

            def _finished(rect):
                selector.close()
                if rect is None:
                    self.set_visible(True)
                    return

                x, y, w, h = rect
                print(f"→ Auswahl (logisch): x={x} y={y} w={w} h={h}")

                display = Gdk.Display.get_default()
                scale = 1
                if display:
                    monitors = display.get_monitors()
                    if monitors.get_n_items() > 0:
                        scale = monitors.get_item(0).get_scale_factor()

                px = int(round(x * scale))
                py = int(round(y * scale))
                pw = int(round(w * scale))
                ph = int(round(h * scale))
                print(f"→ Auswahl (physisch × {scale}): "
                      f"x={px} y={py} w={pw} h={ph}")

                def _do_capture():
                    def _cap():
                        pb = ScreenshotEngine.capture_area(px, py, pw, ph)
                        self._open_editor(pb)
                        return False
                    GLib.timeout_add(300, _cap)

                self._start_countdown(_do_capture)

            selector.on_finish = _finished
            selector.present()
            return False

        GLib.timeout_add(350, _run_selector)

    def on_fullscreen_clicked(self, btn):
        self.set_visible(False)

        def _do_capture():
            def _cap():
                pb = ScreenshotEngine.capture_fullscreen()
                self._open_editor(pb)
                return False
            GLib.timeout_add(350, _cap)

        self._start_countdown(_do_capture)

    def on_window_clicked(self, btn):
        self.set_visible(False)

        def _do_capture():
            def _cap():
                pb = ScreenshotEngine.capture_active_window()
                self._open_editor(pb)
                return False
            GLib.timeout_add(500, _cap)

        self._start_countdown(_do_capture)


