# ===================== Screenshot-Engine =====================

class ScreenshotEngine:
    @staticmethod
    def _has(cmd):
        return subprocess.run(["which", cmd],
                              capture_output=True).returncode == 0

    @staticmethod
    def capture_fullscreen():
        if not ScreenshotEngine._has("import"):
            print("✘ ImageMagick 'import' nicht gefunden")
            return None
        fd, tmp = tempfile.mkstemp(suffix=".png", prefix="gs_full_")
        os.close(fd)
        try:
            t0 = time.time()
            r = subprocess.run(["import", "-window", "root", tmp],
                               capture_output=True, timeout=15,
                               stdin=subprocess.DEVNULL)
            t1 = time.time()
            print(f"  import dauerte {t1 - t0:.2f}s")
            if r.returncode != 0 or not os.path.exists(tmp):
                print("✘ import fehlgeschlagen")
                return None
            pb = GdkPixbuf.Pixbuf.new_from_file(tmp)
            print(f"✔ Aufnahme (Vollbild): {pb.get_width()}x{pb.get_height()}")
            return pb
        finally:
            try: os.unlink(tmp)
            except: pass

    @staticmethod
    def capture_area(x, y, w, h):
        if not ScreenshotEngine._has("import"):
            print("✘ ImageMagick 'import' nicht gefunden")
            return None
        if w < 1 or h < 1:
            return None
        fd, tmp = tempfile.mkstemp(suffix=".png", prefix="gs_area_")
        os.close(fd)
        try:
            cmd = ["import", "-window", "root",
                   "-crop", f"{int(w)}x{int(h)}+{int(x)}+{int(y)}",
                   "+repage", tmp]
            t0 = time.time()
            r = subprocess.run(cmd, capture_output=True, timeout=15,
                               stdin=subprocess.DEVNULL)
            t1 = time.time()
            print(f"  import dauerte {t1 - t0:.2f}s")
            if r.returncode != 0 or not os.path.exists(tmp):
                print("✘ Bereichsaufnahme fehlgeschlagen")
                return None
            pb = GdkPixbuf.Pixbuf.new_from_file(tmp)
            print(f"✔ Aufnahme (Bereich): {pb.get_width()}x{pb.get_height()}")
            return pb
        finally:
            try: os.unlink(tmp)
            except: pass

    @staticmethod
    def capture_active_window():
        if not ScreenshotEngine._has("xdotool"):
            print("✘ xdotool nicht installiert")
            return None
        try:
            r = subprocess.run(["xdotool", "getactivewindow"],
                               capture_output=True, text=True, timeout=3)
            if r.returncode != 0 or not r.stdout.strip():
                print("✘ Kein aktives Fenster")
                return None
            win_id = r.stdout.strip()
            print(f"→ Aktives Fenster: {win_id}")

            if ScreenshotEngine._has("import"):
                fd, tmp = tempfile.mkstemp(suffix=".png", prefix="gs_win_")
                os.close(fd)
                try:
                    t0 = time.time()
                    r2 = subprocess.run(["import", "-window", win_id, tmp],
                                        capture_output=True, timeout=15,
                                        stdin=subprocess.DEVNULL)
                    t1 = time.time()
                    print(f"  import dauerte {t1 - t0:.2f}s")
                    if r2.returncode == 0 and os.path.exists(tmp) \
                            and os.path.getsize(tmp) > 0:
                        pb = GdkPixbuf.Pixbuf.new_from_file(tmp)
                        print(f"✔ Aufnahme (Fenster): "
                              f"{pb.get_width()}x{pb.get_height()}")
                        return pb
                finally:
                    try: os.unlink(tmp)
                    except: pass
        except Exception as e:
            print(f"✘ Fehler bei Fensteraufnahme: {e}")
        return None


