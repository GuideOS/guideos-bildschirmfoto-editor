    # =====================================================================

    def _persist(self):
        try:
            save_tool_settings({
                "color":           self.current_color,
                "line_width":      self.current_line_width,
                "text_size":       self.current_text_size,
                "magnifier_scale": self.magnifier_scale,
                "pixel_size":      self.pixel_size,
                "zoom_level":      self.zoom_level,
            })
        except Exception as e:
            print(f"Konnte Einstellungen nicht speichern: {e}")

    def on_tool_toggled(self, btn, tool_id):
        if btn.get_active():
            self.current_tool = tool_id
        elif self.current_tool == tool_id:
            self.current_tool = None
        if self.current_tool != Tool.SELECT:
            self.selected_shape = None
            self.moving_shape = False
        self.drawing_area.queue_draw()

    def on_color_changed(self, btn, _pspec):
        c = btn.get_rgba()
        self.current_color = (c.red, c.green, c.blue, c.alpha)
        self._persist()

    def on_press(self, gesture, n_press, x, y):
        if self.current_tool == Tool.SELECT:
            ix, iy = self.screen_to_image_coords(x, y)
            hit = self._hit_test(ix, iy)
            self.selected_shape = hit
            if hit is not None:
                self.moving_shape = True
                self.move_last_x = ix; self.move_last_y = iy
            self.drawing_area.queue_draw()
            return

        if self.current_tool == Tool.TEXT:
            ix, iy = self.screen_to_image_coords(x, y)
            TextInputDialog.show(self, lambda txt: self._add_text(ix, iy, txt))
            return

        if self.current_tool is None:
            return

        self.drawing = True
        self.start_x = x; self.start_y = y
        self.current_x = x; self.current_y = y
        if self.current_tool == Tool.FREEHAND:
            ix, iy = self.screen_to_image_coords(x, y)
            self.freehand_points = [(ix, iy)]
        self.drawing_area.queue_draw()

    def on_motion(self, ctrl, x, y):
        if self.moving_shape and self.selected_shape is not None:
            ix, iy = self.screen_to_image_coords(x, y)
            dx = ix - self.move_last_x; dy = iy - self.move_last_y
            self._move_shape(self.selected_shape, dx, dy)
            self.move_last_x = ix; self.move_last_y = iy
            self.drawing_area.queue_draw()
            return

        if not self.drawing:
            return
        self.current_x = x; self.current_y = y
        if self.current_tool == Tool.FREEHAND:
            ix, iy = self.screen_to_image_coords(x, y)
            self.freehand_points.append((ix, iy))
        self.drawing_area.queue_draw()

    def on_release(self, gesture, n_press, x, y):
        if self.moving_shape:
            self.moving_shape = False
            self.drawing_area.queue_draw()
            return

        if not self.drawing:
            return
        self.drawing = False

        if self.current_tool == Tool.MAGNIFIER:
            self.drawing_area.queue_draw()
            return

        if self.current_tool == Tool.FREEHAND:
            if len(self.freehand_points) > 1:
                shape = self._make_shape(
                    Tool.FREEHAND,
                    self.freehand_points[0][0], self.freehand_points[0][1],
                    self.freehand_points[-1][0], self.freehand_points[-1][1],
                    points=list(self.freehand_points))
                self.shapes.append(shape)
                self.undo_stack.append(shape)
                self.redo_stack.clear()
            self.freehand_points = []
        elif self.current_tool == Tool.PIXELATE:
            sx, sy = self.screen_to_image_coords(self.start_x, self.start_y)
            cx, cy = self.screen_to_image_coords(x, y)
            if abs(cx - sx) > 4 and abs(cy - sy) > 4:
                shape = self._make_shape(Tool.PIXELATE, sx, sy, cx, cy,
                                         pixel_size=self.pixel_size)
                self.shapes.append(shape)
                self.undo_stack.append(shape)
                self.redo_stack.clear()
        else:
            sx, sy = self.screen_to_image_coords(self.start_x, self.start_y)
            cx, cy = self.screen_to_image_coords(x, y)
            shape = self._make_shape(self.current_tool, sx, sy, cx, cy)
            self.shapes.append(shape)
            self.undo_stack.append(shape)
            self.redo_stack.clear()

        self.drawing_area.queue_draw()

    def on_key_pressed(self, ctrl, keyval, keycode, state):
        keyname = Gdk.keyval_name(keyval)
        if keyname in ("Delete", "KP_Delete", "BackSpace"):
            if self.selected_shape is not None:
                try:
                    self.shapes.remove(self.selected_shape)
                except ValueError:
                    pass
                self.selected_shape = None
                self.moving_shape = False
                self.drawing_area.queue_draw()
                return True
        if keyname == "Escape":
            if self.selected_shape is not None:
                self.selected_shape = None
                self.moving_shape = False
                self.drawing_area.queue_draw()
                return True
        return False

    def on_scroll(self, ctrl, dx, dy):
        state = ctrl.get_current_event_state()
        if not (state & Gdk.ModifierType.CONTROL_MASK):
            return False
        if dy < 0:
            self.zoom_level = min(self.max_zoom,
                                  self.zoom_level * self.zoom_factor)
        elif dy > 0:
            self.zoom_level = max(self.min_zoom,
                                  self.zoom_level / self.zoom_factor)
        self.update_zoom()
        self._persist()
        return True

    def update_zoom(self):
        w = max(1, int(self.image_width  * self.zoom_level))
        h = max(1, int(self.image_height * self.zoom_level))
        self.drawing_area.set_size_request(w, h)
        self.drawing_area.queue_draw()
        self.set_title(
            f"GuideOS Bildschirmfoto-Editor ({int(self.zoom_level*100)}%)")

    def screen_to_image_coords(self, sx, sy):
        ix = max(0, min(sx / self.zoom_level, self.image_width))
        iy = max(0, min(sy / self.zoom_level, self.image_height))
        return ix, iy

    def _shape_bbox(self, s):
        if s["type"] == Tool.TEXT:
            surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)
            cr = cairo.Context(surface)
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                                cairo.FONT_WEIGHT_NORMAL)
            cr.set_font_size(s.get("text_size", 24))
            ext = cr.text_extents(s.get("text") or "")
            x1 = s["x1"] + ext.x_bearing
            y1 = s["y1"] + ext.y_bearing
            return (x1, y1, x1 + ext.width, y1 + ext.height)
        if s["type"] == Tool.FREEHAND:
            pts = s.get("points") or []
            if not pts:
                return (0, 0, 0, 0)
            xs = [p[0] for p in pts]; ys = [p[1] for p in pts]
            return (min(xs), min(ys), max(xs), max(ys))
        x1, y1, x2, y2 = s["x1"], s["y1"], s["x2"], s["y2"]
        return (min(x1, x2), min(y1, y2), max(x1, x2), max(y1, y2))

    def _hit_test(self, ix, iy):
        tol = 8 / max(self.zoom_level, 0.1)
        for s in reversed(self.shapes):
            bx1, by1, bx2, by2 = self._shape_bbox(s)
            if (bx1 - tol <= ix <= bx2 + tol and
                    by1 - tol <= iy <= by2 + tol):
                return s
        return None

    def _move_shape(self, s, dx, dy):
        s["x1"] += dx; s["y1"] += dy
        s["x2"] += dx; s["y2"] += dy
        if s["type"] == Tool.FREEHAND and s.get("points"):
            s["points"] = [(p[0] + dx, p[1] + dy) for p in s["points"]]

    def on_draw(self, area, cr, width, height, user_data):
        cr.new_path()
        cr.scale(self.zoom_level, self.zoom_level)
        cr.set_source_surface(self.background_surface, 0, 0)
        cr.paint()

        for s in self.shapes:
            cr.new_path()
            self.draw_shape(cr, s)

        if self.drawing:
            cr.new_path()
            if self.current_tool == Tool.FREEHAND:
                if len(self.freehand_points) > 1:
                    self.draw_freehand_points(cr, self.freehand_points,
                                              self.current_color,
                                              self.current_line_width)
            elif self.current_tool == Tool.PIXELATE:
                sx, sy = self.screen_to_image_coords(self.start_x, self.start_y)
                cx, cy = self.screen_to_image_coords(self.current_x,
                                                     self.current_y)
                x = min(sx, cx); y = min(sy, cy)
                w = abs(cx - sx); h = abs(cy - sy)
                cr.set_source_rgba(1, 0.5, 0, 0.6)
                cr.set_line_width(2 / self.zoom_level)
                cr.set_dash([6 / self.zoom_level, 3 / self.zoom_level], 0)
                cr.rectangle(x, y, w, h); cr.stroke()
                cr.set_dash([], 0)
            elif self.current_tool == Tool.MAGNIFIER:
                sx, sy = self.screen_to_image_coords(self.start_x, self.start_y)
                cx, cy = self.screen_to_image_coords(self.current_x,
                                                     self.current_y)
                self.draw_magnifier(cr, sx, sy, cx, cy)
            elif self.current_tool not in (None, Tool.TEXT):
                sx, sy = self.screen_to_image_coords(self.start_x, self.start_y)
                cx, cy = self.screen_to_image_coords(self.current_x,
                                                     self.current_y)
                temp = self._make_shape(self.current_tool, sx, sy, cx, cy)
                self.draw_shape(cr, temp)

        if self.selected_shape is not None:
            cr.new_path()
            bx1, by1, bx2, by2 = self._shape_bbox(self.selected_shape)
            cr.save()
            cr.set_source_rgba(0.12, 0.68, 0.96, 0.95)
            cr.set_line_width(2 / self.zoom_level)
            dash = max(2, 6 / self.zoom_level)
            cr.set_dash([dash, dash * 0.6], 0)
            pad = 4 / self.zoom_level
            cr.rectangle(bx1 - pad, by1 - pad,
                         (bx2 - bx1) + 2 * pad,
                         (by2 - by1) + 2 * pad)
            cr.stroke()
            cr.restore()

        cr.new_path()

    def _pixbuf_to_surface(self, pixbuf):
        w = pixbuf.get_width(); h = pixbuf.get_height()
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
        cr = cairo.Context(surface)
        Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
        cr.paint()
        return surface

    def _make_shape(self, tool, x1, y1, x2, y2, text=None, points=None,
                    pixel_size=None):
        return {
            "type": tool,
            "x1": x1, "y1": y1, "x2": x2, "y2": y2,
            "color": self.current_color,
            "width": self.current_line_width,
            "text": text,
            "text_size": self.current_text_size,
            "points": points,
            "pixel_size": pixel_size if pixel_size is not None
                          else self.pixel_size,
        }

    def draw_shape(self, cr, s):
        cr.set_source_rgba(*s["color"])
        if s["type"] == Tool.PIXELATE:
            self.draw_pixelate(cr, s)
        elif s["type"] == Tool.FREEHAND:
            pts = s.get("points", [])
            if len(pts) > 1:
                self.draw_freehand_points(cr, pts, s["color"], s["width"])
        elif s["type"] == Tool.MARKER:
            cr.save()
            cr.set_operator(cairo.OPERATOR_OVER)
            cr.set_line_width(s["width"] * 3)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_line_join(cairo.LINE_JOIN_ROUND)
            r, g, b, _ = s["color"]
            cr.set_source_rgba(r, g, b, 0.40)
            cr.move_to(s["x1"], s["y1"]); cr.line_to(s["x2"], s["y2"])
            cr.stroke()
            cr.restore()
        elif s["type"] == Tool.LINE:
            cr.set_line_width(s["width"])
            cr.move_to(s["x1"], s["y1"]); cr.line_to(s["x2"], s["y2"])
            cr.stroke()
        elif s["type"] == Tool.RECT:
            cr.set_line_width(s["width"])
            x = min(s["x1"], s["x2"]); y = min(s["y1"], s["y2"])
            w = abs(s["x2"] - s["x1"]); h = abs(s["y2"] - s["y1"])
            cr.rectangle(x, y, w, h); cr.stroke()
        elif s["type"] == Tool.ELLIPSE:
            cr.set_line_width(s["width"])
            x = (s["x1"] + s["x2"]) / 2; y = (s["y1"] + s["y2"]) / 2
            rx = abs(s["x2"] - s["x1"]) / 2; ry = abs(s["y2"] - s["y1"]) / 2
            if rx > 0 and ry > 0:
                cr.save(); cr.translate(x, y); cr.scale(rx, ry)
                cr.arc(0, 0, 1, 0, 2 * math.pi); cr.restore(); cr.stroke()
        elif s["type"] == Tool.ARROW:
            cr.set_line_width(s["width"])
            self.draw_arrow(cr, s["x1"], s["y1"], s["x2"], s["y2"])
        elif s["type"] == Tool.TEXT and s["text"]:
            cr.set_line_width(s["width"])
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                                cairo.FONT_WEIGHT_NORMAL)
            cr.set_font_size(s["text_size"])
            cr.move_to(s["x1"], s["y1"])
            cr.show_text(s["text"])
        cr.new_path()

    def draw_arrow(self, cr, x1, y1, x2, y2):
        cr.move_to(x1, y1); cr.line_to(x2, y2); cr.stroke()
        angle = math.atan2(y2 - y1, x2 - x1)
        length = 12 + self.current_line_width
        for da in (math.pi / 6, -math.pi / 6):
            a = angle + da
            cr.move_to(x2, y2)
            cr.line_to(x2 - length * math.cos(a), y2 - length * math.sin(a))
        cr.stroke()

    def draw_freehand_points(self, cr, points, color, line_width):
        if len(points) < 2:
            return
        cr.set_source_rgba(*color)
        cr.set_line_width(line_width)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.move_to(points[0][0], points[0][1])
        for i in range(1, len(points) - 1):
            mx = (points[i][0] + points[i+1][0]) / 2
            my = (points[i][1] + points[i+1][1]) / 2
            cx, cy = points[i][0], points[i][1]
            cr.curve_to(cx, cy, cx, cy, mx, my)
        cr.line_to(points[-1][0], points[-1][1])
        cr.stroke()
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        cr.set_line_join(cairo.LINE_JOIN_MITER)

    def draw_pixelate(self, cr, s):
        x1 = int(min(s["x1"], s["x2"])); y1 = int(min(s["y1"], s["y2"]))
        x2 = int(max(s["x1"], s["x2"])); y2 = int(max(s["y1"], s["y2"]))
        ps = int(s.get("pixel_size", self.pixel_size))
        if ps < 1: ps = 1
        x1 = max(0, x1); y1 = max(0, y1)
        x2 = min(self.image_width, x2); y2 = min(self.image_height, y2)
        if x2 <= x1 or y2 <= y1:
            return
        bg = self.background_surface
        stride = bg.get_stride()
        data = bg.get_data()
        bx = x1
        while bx < x2:
            by = y1
            while by < y2:
                bx2 = min(bx + ps, x2); by2 = min(by + ps, y2)
                r_sum = g_sum = b_sum = 0; count = 0
                for py in range(by, by2):
                    for px in range(bx, bx2):
                        off = py * stride + px * 4
                        b_sum += data[off + 0]; g_sum += data[off + 1]
                        r_sum += data[off + 2]; count += 1
                if count > 0:
                    r = r_sum / count / 255.0
                    g = g_sum / count / 255.0
                    b = b_sum / count / 255.0
                    cr.set_source_rgb(r, g, b)
                    cr.rectangle(bx, by, bx2 - bx, by2 - by); cr.fill()
                by += ps
            bx += ps

    def draw_magnifier(self, cr, x1, y1, x2, y2):
        cr.new_path()
        size = 260
        cr.set_source_rgba(0, 0, 0, 0.7)
        cr.set_line_width(2 / self.zoom_level)
        cr.arc(x2, y2, size / 2, 0, 2 * math.pi); cr.stroke()
        cr.new_path()
        scale = self.magnifier_scale
        source_x = x2 - (size / 2) / scale
        source_y = y2 - (size / 2) / scale
        source_sz = size / scale
        source_x = max(0, min(source_x, self.image_width  - source_sz))
        source_y = max(0, min(source_y, self.image_height - source_sz))
        cr.save()
        cr.arc(x2, y2, size / 2 - 2, 0, 2 * math.pi); cr.clip()
        cr.translate(x2, y2); cr.scale(scale, scale)
        cr.translate(-source_x - source_sz / 2, -source_y - source_sz / 2)
        cr.set_source_surface(self.background_surface, 0, 0); cr.paint()
        for shape in self.shapes:
            cr.new_path()
            self.draw_shape(cr, shape)
        cr.restore()
        cr.new_path()
        cr.set_source_rgba(1, 0, 0, 0.8)
        cr.set_line_width(2 / self.zoom_level)
        cr.move_to(x2, y2 - 12); cr.line_to(x2, y2 + 12)
        cr.move_to(x2 - 12, y2); cr.line_to(x2 + 12, y2)
        cr.stroke()
        cr.new_path()

    def _add_text(self, x, y, text):
        shape = self._make_shape(Tool.TEXT, x, y, x, y, text=text)
        self.shapes.append(shape)
        self.undo_stack.append(shape)
        self.redo_stack.clear()
        self.drawing_area.queue_draw()

    def on_undo_clicked(self, btn):
        if self.shapes:
            self.redo_stack.append(self.shapes.pop())
            self.drawing_area.queue_draw()

    def on_redo_clicked(self, btn):
        if self.redo_stack:
            self.shapes.append(self.redo_stack.pop())
            self.drawing_area.queue_draw()

    def _render_to_surface(self):
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32,
                                     self.image_width, self.image_height)
        cr = cairo.Context(surface)
        cr.new_path()
        cr.set_source_surface(self.background_surface, 0, 0)
        cr.paint()
        for shape in self.shapes:
            cr.new_path()
            self.draw_shape(cr, shape)
        return surface

