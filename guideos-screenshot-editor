class AreaSelectorWindow(Gtk.Window):
    def __init__(self, parent=None, **kwargs):
        super().__init__(**kwargs)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_modal(True)
        if parent is not None:
            self.set_transient_for(parent)

        self.add_css_class("gs-transparent-window")

        self.start_x = self.start_y = 0.0
        self.cur_x = self.cur_y = 0.0
        self.selecting = False
        self.result_rect = None
        self.finished = False
        self.on_finish = None

        display = Gdk.Display.get_default()
        if display:
            monitors = display.get_monitors()
            if monitors.get_n_items() > 0:
                geo = monitors.get_item(0).get_geometry()
                self.set_default_size(geo.width, geo.height)

        self.area = Gtk.DrawingArea()
        self.area.set_draw_func(self._on_draw, None)
        self.area.set_hexpand(True)
        self.area.set_vexpand(True)
        self.area.add_css_class("gs-transparent-area")

        click = Gtk.GestureClick()
        click.set_button(1)
        click.connect("pressed", self._on_press)
        click.connect("released", self._on_release)
        self.area.add_controller(click)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        self.area.add_controller(motion)

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self._on_key)
        self.add_controller(key)

        self.set_child(self.area)

        css = b"""
        .gs-transparent-window { background: none; }
        .gs-transparent-area   { background: none; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.connect("map", self._on_map)

    def _on_map(self, _w):
        self.fullscreen()
        GLib.idle_add(lambda: (self.area.grab_focus(), False)[1])
        return False

    def _on_draw(self, area, cr, width, height, data):
        cr.new_path()
        cr.set_source_rgba(0, 0, 0, 0.45)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        if self.selecting or self.result_rect:
            if self.selecting:
                x1, y1 = self.start_x, self.start_y
                x2, y2 = self.cur_x, self.cur_y
            else:
                x1, y1, w0, h0 = self.result_rect
                x2, y2 = x1 + w0, y1 + h0

            x = min(x1, x2); y = min(y1, y2)
            w = abs(x2 - x1); h = abs(y2 - y1)

            cr.new_path()
            cr.set_source_rgba(1, 1, 1, 0.05)
            cr.rectangle(x, y, w, h)
            cr.fill()

            cr.new_path()
            cr.set_source_rgba(0.12, 0.68, 0.96, 1.0)
            cr.set_line_width(2)
            cr.rectangle(x, y, w, h)
            cr.stroke()

            cr.new_path()
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                                cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(14)
            text = f"{int(w)} × {int(h)}"
            ext = cr.text_extents(text)
            tx = x + 8
            ty = y - 8 if y > 30 else y + h + 22
            cr.set_source_rgba(0, 0, 0, 0.8)
            cr.rectangle(tx - 6, ty - ext.height - 4,
                         ext.width + 12, ext.height + 10)
            cr.fill()
            cr.set_source_rgba(1, 1, 1, 1)
            cr.move_to(tx, ty)
            cr.show_text(text)

        cr.new_path()
        hint = ("Bereich mit der Maus aufziehen – "
                "Auswahl wird beim Loslassen übernommen   •   ESC = abbrechen")
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(13)
        ext = cr.text_extents(hint)
        bx = (width - ext.width) / 2 - 15
        by = height - 60
        bw = ext.width + 30
        bh = ext.height + 20
        cr.set_source_rgba(0, 0, 0, 0.85)
        cr.rectangle(bx, by, bw, bh); cr.fill()
        cr.set_source_rgba(0.12, 0.68, 0.96, 1.0)
        cr.set_line_width(2)
        cr.rectangle(bx, by, bw, bh); cr.stroke()
        cr.set_source_rgba(1, 1, 1, 1)
        cr.move_to(bx + 15, by + bh / 2 + ext.height / 2 - 2)
        cr.show_text(hint)

        cr.new_path()

    def _on_press(self, gesture, n_press, x, y):
        self.start_x = x; self.start_y = y
        self.cur_x = x; self.cur_y = y
        self.selecting = True
        self.result_rect = None
        self.area.queue_draw()

    def _on_motion(self, ctrl, x, y):
        if self.selecting:
            self.cur_x = x; self.cur_y = y
            self.area.queue_draw()

    def _on_release(self, gesture, n_press, x, y):
        if not self.selecting:
            return
        self.selecting = False
        x1 = min(self.start_x, x); y1 = min(self.start_y, y)
        w = abs(x - self.start_x); h = abs(y - self.start_y)
        if w >= 1 and h >= 1:
            self.result_rect = (int(x1), int(y1), int(w), int(h))
            self.area.queue_draw()
            GLib.timeout_add(120, self._finish_now)
        else:
            self.area.queue_draw()

    def _finish_now(self):
        if not self.finished:
            self.finished = True
            self._finish()
        return False

    def _on_key(self, ctrl, keyval, keycode, state):
        keyname = Gdk.keyval_name(keyval)
        if keyname == "Escape":
            self.result_rect = None
            self.finished = True
            self._finish()
            return True
        return False

    def _finish(self):
        if self.on_finish:
            self.on_finish(self.result_rect)


# ===================== Text-Eingabe =====================

class TextInputDialog:
    @staticmethod
    def show(parent, on_ok):
        dialog = Adw.MessageDialog(
            transient_for=parent, modal=True,
            heading="Text eingeben",
            body="Der Text wird an der angeklickten Stelle eingefügt.",
        )
        entry = Gtk.Entry()
        entry.set_placeholder_text("Text hier eingeben…")
        entry.set_margin_top(8); entry.set_margin_bottom(8)
        dialog.set_extra_child(entry)

        dialog.add_response("cancel", "Abbrechen")
        dialog.add_response("ok", "OK")
        dialog.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("ok")
        dialog.set_close_response("cancel")

        def on_response(d, response):
            if response == "ok":
                text = entry.get_text().strip()
                if text:
                    on_ok(text)
            d.close()

        dialog.connect("response", on_response)
        dialog.present()
        GLib.idle_add(lambda: (entry.grab_focus(), False)[1])


