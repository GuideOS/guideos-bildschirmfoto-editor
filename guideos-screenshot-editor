class EditorWindow(Adw.ApplicationWindow):

    TOOL_BTN_SIZE  = 42
    TOOL_ICON_SIZE = 26

    def __init__(self, image_pixbuf, **kwargs):
        super().__init__(**kwargs)
        self.set_title("GuideOS Bildschirmfoto-Editor")
        self.set_default_size(1100, 800)

        icon_path = load_program_icon()
        if icon_path:
            try:
                self.set_icon_name(icon_path)
            except Exception:
                pass

        settings = load_tool_settings()

        self.original_pixbuf    = image_pixbuf
        self.background_surface = self._pixbuf_to_surface(image_pixbuf)
        self.image_width        = self.background_surface.get_width()
        self.image_height       = self.background_surface.get_height()

        self.shapes = []
        self.undo_stack = []
        self.redo_stack = []

        self.current_tool = None
        self.current_color = tuple(settings["color"])
        self.current_line_width = float(settings["line_width"])
        self.current_text_size = float(settings["text_size"])
        self.magnifier_scale = float(settings["magnifier_scale"])
        self.pixel_size = int(settings["pixel_size"])

        self.drawing = False
        self.start_x = self.start_y = 0.0
        self.current_x = self.current_y = 0.0
        self.freehand_points = []

        self.selected_shape = None
        self.moving_shape = False
        self.move_last_x = self.move_last_y = 0.0

        saved_zoom = float(settings.get("zoom_level", 0.4))
        if self.image_width < 300 or self.image_height < 300:
            self.zoom_level = max(saved_zoom, 1.0)
        else:
            self.zoom_level = saved_zoom
        self.min_zoom = 0.05
        self.max_zoom = 10.0
        self.zoom_factor = 1.08

        self.save_folder = load_save_folder()
        self.installed_apps = None
        self.default_app_path, self.default_app_name = load_default_app()

        self.tool_buttons = {}

        # ---------------------------------------------------------------
        #  Werkzeug-Button-Fabrik
        # ---------------------------------------------------------------
        def make_tool_button(tool_id, label, custom_names, fallback_icon):
            if tool_id:
                b = Gtk.ToggleButton()
                b.connect("toggled", self.on_tool_toggled, tool_id)
                self.tool_buttons[tool_id] = b
            else:
                b = Gtk.Button()

            b.set_tooltip_text(label)
            b.add_css_class("tool-button")
            b.set_size_request(self.TOOL_BTN_SIZE, self.TOOL_BTN_SIZE)

            img = load_pixmap_icon(custom_names, self.TOOL_ICON_SIZE)
            if img is None:
                img = Gtk.Image.new_from_icon_name(fallback_icon)
                img.set_pixel_size(self.TOOL_ICON_SIZE)
            b.set_child(img)
            return b

        # ---------------------------------------------------------------
        #  Werkzeug-Buttons
        # ---------------------------------------------------------------
        select_btn    = make_tool_button(Tool.SELECT,    "Auswählen",
                                         ["Auswahl.png", "Auswahl"],
                                         "edit-select-all-symbolic")
        line_btn      = make_tool_button(Tool.LINE,      "Linie",
                                         ["Linie.png", "Linie"],
                                         "draw-line-symbolic")
        rect_btn      = make_tool_button(Tool.RECT,      "Rechteck",
                                         ["Quadrat.png", "Quadrat",
                                          "Rechteck.png", "Rechteck"],
                                         "checkbox-checked-symbolic")
        ellipse_btn   = make_tool_button(Tool.ELLIPSE,   "Kreis",
