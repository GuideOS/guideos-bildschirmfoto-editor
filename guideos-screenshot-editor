# ===================== Config =====================

def _load_config():
    try:
        if os.path.exists(CONFIG_FILE):
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
    except Exception:
        pass
    return {}


def _save_config(updates):
    try:
        os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
        cfg = _load_config()
        cfg.update(updates)
        with open(CONFIG_FILE, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print(f"Konnte Config nicht speichern: {e}")


def load_tool_settings():
    cfg = _load_config()
    out = dict(DEFAULT_TOOL_SETTINGS)
    try:
        if isinstance(cfg.get("tool_color"), list) and len(cfg["tool_color"]) == 4:
            out["color"] = [float(x) for x in cfg["tool_color"]]
        for k_src, k_dst, cast in [
            ("tool_line_width",      "line_width",      float),
            ("tool_text_size",       "text_size",       float),
            ("tool_magnifier_scale", "magnifier_scale", float),
            ("tool_pixel_size",      "pixel_size",      int),
            ("tool_zoom_level",      "zoom_level",      float),
        ]:
            if k_src in cfg:
                out[k_dst] = cast(cfg[k_src])
    except Exception:
        pass
    return out


def save_tool_settings(s):
    _save_config({
        "tool_color":           list(s["color"]),
        "tool_line_width":      s["line_width"],
        "tool_text_size":       s["text_size"],
        "tool_magnifier_scale": s["magnifier_scale"],
        "tool_pixel_size":      s["pixel_size"],
        "tool_zoom_level":      s["zoom_level"],
    })


def load_save_folder():
    folder = _load_config().get("save_folder")
    if folder and os.path.isdir(folder):
        return folder
    home = os.path.expanduser("~")
    for candidate in ("Bilder", "Pictures"):
        path = os.path.join(home, candidate)
        if os.path.isdir(path):
            return path
    return home


def save_save_folder(folder):
    _save_config({"save_folder": folder})


def load_timer_setting():
    d = _load_config().get("timer_delay", 0)
    return d if d in (0, 3, 5, 10) else 0


def save_timer_setting(d):
    _save_config({"timer_delay": d})


def load_default_app():
    cfg = _load_config()
    return cfg.get("default_app"), cfg.get("default_app_name")


def save_default_app(app_path, app_name):
    _save_config({"default_app": app_path, "default_app_name": app_name})


# ===================== Icon-Loader =====================

_ICON_CACHE = {}
_ICON_DIR_LISTING = None


def _get_dir_listing():
    global _ICON_DIR_LISTING
    if _ICON_DIR_LISTING is not None:
        return _ICON_DIR_LISTING

    import unicodedata
    listing = {}
    try:
        for f in os.listdir(PIXMAPS_DIR):
            key = unicodedata.normalize("NFC", f).lower()
            listing[key] = f
            base, _ = os.path.splitext(f)
            key2 = unicodedata.normalize("NFC", base).lower()
            listing.setdefault(key2, f)
    except Exception as e:
        print(f"✘ Kann {PIXMAPS_DIR} nicht lesen: {e}", flush=True)

    _ICON_DIR_LISTING = listing
    return listing


def _find_icon_file(name):
    import unicodedata
    listing = _get_dir_listing()
    extensions = [".png", ".svg", ".jpg", ".jpeg"]
    if "." in name and name.rsplit(".", 1)[-1].lower() in (
            "png", "svg", "jpg", "jpeg"):
        candidates = [name]
    else:
        candidates = [name + ext for ext in extensions]

    for cand in candidates:
        key = unicodedata.normalize("NFC", cand).lower()
        if key in listing:
            return os.path.join(PIXMAPS_DIR, listing[key])
    return None


def load_pixmap_icon(custom_names, size):
    for name in custom_names:
        path = _find_icon_file(name)
        if not path:
            continue
        key = (path, size)
        if key in _ICON_CACHE:
            texture = _ICON_CACHE[key]
            img = Gtk.Image.new_from_paintable(texture)
            img.set_pixel_size(size)
            return img
        try:
            gfile = Gio.File.new_for_path(path)
            texture = Gdk.Texture.new_from_file(gfile)
            _ICON_CACHE[key] = texture
            img = Gtk.Image.new_from_paintable(texture)
            img.set_pixel_size(size)
            return img
        except Exception:
            pass
        try:
            with open(path, "rb") as f:
                data = f.read()
            gbytes = GLib.Bytes.new(data)
            texture = Gdk.Texture.new_from_bytes(gbytes)
            _ICON_CACHE[key] = texture
            img = Gtk.Image.new_from_paintable(texture)
            img.set_pixel_size(size)
            return img
        except Exception:
            pass
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file(path)
            texture = Gdk.Texture.new_for_pixbuf(pb)
            _ICON_CACHE[key] = texture
            img = Gtk.Image.new_from_paintable(texture)
            img.set_pixel_size(size)
            return img
        except Exception:
            pass
    return None


def load_program_icon():
