            subprocess.Popen([command, tmp])
            save_default_app(command, app_name)
            self.default_app_path = command
            self.default_app_name = app_name
            print(f"→ Geöffnet mit {app_name}: {tmp}")
        except Exception as e:
            print(f"✘ Fehler beim Öffnen: {e}")


# ===================== Countdown-Overlay =====================

class CountdownOverlay(Gtk.Window):
    def __init__(self, seconds, parent=None, **kwargs):
        super().__init__(**kwargs)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_modal(True)
        if parent is not None:
            self.set_transient_for(parent)
        self.set_default_size(180, 180)

        self.remaining = seconds
        self.area = Gtk.DrawingArea()
        self.area.set_draw_func(self._draw, None)
        self.area.set_hexpand(True); self.area.set_vexpand(True)
        self.set_child(self.area)

    def _draw(self, area, cr, w, h, data):
        cr.new_path()
        cx, cy = w / 2, h / 2
        radius = min(w, h) / 2 - 8
        cr.set_source_rgba(0, 0, 0, 0.75)
        cr.arc(cx, cy, radius, 0, 2 * math.pi); cr.fill()
        cr.set_source_rgba(0.12, 0.68, 0.96, 1.0)
        cr.set_line_width(5)
        cr.arc(cx, cy, radius, 0, 2 * math.pi); cr.stroke()
        cr.set_source_rgba(1, 1, 1, 1)
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(80)
        text = str(self.remaining)
        ext = cr.text_extents(text)
        cr.move_to(cx - ext.width / 2 - ext.x_bearing,
                   cy - ext.height / 2 - ext.y_bearing)
        cr.show_text(text)

    def set_remaining(self, secs):
        self.remaining = secs
        self.area.queue_draw()


