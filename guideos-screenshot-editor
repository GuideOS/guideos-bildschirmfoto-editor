    def _make_value_dropdown(self, title, values, unit, on_change=None,
                             initial=None, fmt=None):
        """Erzeugt eine VBox mit Titel-Label oben und Gtk.DropDown darunter.
        Zeigt die Werte inline (z. B. '3 px') statt in einem Popover."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.set_valign(Gtk.Align.CENTER)

        label = Gtk.Label()
        label.set_markup(f"<b>{title}</b>")
        label.add_css_class("value-label")
        label.set_halign(Gtk.Align.CENTER)

        options = []
        for v in values:
            if fmt == ":.1f":
                options.append(f"{v:.1f} {unit}")
            else:
                options.append(f"{v} {unit}")

        model = Gtk.StringList.new(options)
        dropdown = Gtk.DropDown.new(model, None)
        dropdown.add_css_class("value-dropdown")
        dropdown.set_size_request(90, -1)

        # Initial-Auswahl setzen
        if initial is not None:
            try:
                if isinstance(initial, float) and any(
                        isinstance(x, float) for x in values):
                    idx = next(i for i, x in enumerate(values)
                               if abs(float(x) - float(initial)) < 0.01)
                else:
                    idx = values.index(int(initial)) \
                        if all(isinstance(x, int) for x in values) \
                        else next(i for i, x in enumerate(values)
                                  if abs(float(x) - float(initial)) < 0.01)
                dropdown.set_selected(idx)
            except (ValueError, StopIteration):
                dropdown.set_selected(0)

        def _on_selected(dd, _pspec):
            i = dd.get_selected()
            if 0 <= i < len(values):
                if on_change:
                    on_change(values[i])

        dropdown.connect("notify::selected", _on_selected)

        box.append(label)
        box.append(dropdown)
        return box

